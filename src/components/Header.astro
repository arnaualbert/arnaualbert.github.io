---
const navItems = [
  { path: 'overview', label: 'Overview' },
  { path: 'about', label: 'About' },
  { path: 'experience', label: 'Experience' },
  { path: 'projects', label: 'Projects' },
  { path: 'contact', label: 'Contact' },
];
const active = 'overview';
---

<header class="fixed top-0 left-0 w-full z-50 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
  <div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 flex items-center justify-between gap-3">
    <!-- Brand -->
    <div class="flex items-center gap-2 sm:gap-space-md min-w-0">
      <a class="flex items-center gap-space-sm min-w-0" data-path="overview" href="#">
        <span class="font-headline-sm text-headline-sm text-on-surface font-semibold tracking-tight truncate">
          Arnau Albert Sánchez
        </span>
      </a>
      <span class="hidden sm:inline-flex items-center px-space-xs py-0.5 rounded-DEFAULT bg-surface-container-high text-on-surface-variant font-code text-code whitespace-nowrap">
        Full Stack &amp; DevOps
      </span>
    </div>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-space-lg">
      {navItems.map((item) => (
        <a
          aria-current={item.path === active ? 'page' : undefined}
          class={
            item.path === active
              ? 'transition-colors text-on-surface bg-surface-container-high rounded px-3 py-1.5 font-medium'
              : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-3 py-1.5 rounded transition-colors font-label-md text-label-md'
          }
          data-path={item.path}
          href="#"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right actions -->
    <div class="flex items-center gap-2 sm:gap-space-md shrink-0">
      <div class="hidden lg:flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-low">
        <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
          Available for roles
        </span>
      </div>

      <a
        class="hidden sm:inline-flex px-space-md py-1.5 rounded bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md font-medium"
        data-path="resume"
        href="#"
      >
        Resume / Contact
      </a>

      <!-- Hamburger (mobile only) -->
      <button
        id="mobileMenuBtn"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobileMenu"
        class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors"
      >
        <span class="material-symbols-outlined text-[20px]" data-icon>menu</span>
      </button>

      <div class="hidden sm:flex w-8 h-8 rounded-full bg-primary items-center justify-center shrink-0">
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobileMenu"
    class="md:hidden hidden border-t border-outline-variant/30 bg-surface/95 backdrop-blur-xl"
  >
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-col gap-1">
      {navItems.map((item) => (
        <a
          class={
            item.path === active
              ? 'text-on-surface bg-surface-container-high rounded px-3 py-2.5 font-medium font-label-md text-label-md'
              : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low rounded px-3 py-2.5 transition-colors font-label-md text-label-md'
          }
          data-path={item.path}
          href="#"
          data-mobile-link
        >
          {item.label}
        </a>
      ))}
      <a
        class="mt-1 px-3 py-2.5 rounded bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md font-medium text-center"
        href="#contact"
        data-mobile-link
      >
        Resume / Contact
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');

  if (btn && menu) {
    const icon = btn.querySelector('[data-icon]');
    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (icon) icon.textContent = open ? 'close' : 'menu';
    };

    btn.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('[data-mobile-link]').forEach((el) =>
      el.addEventListener('click', () => setOpen(false)),
    );

    // Auto-close when resizing past the md breakpoint, or on Escape
    window.addEventListener('resize', () => {
      if (window.matchMedia('(min-width: 768px)').matches) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>