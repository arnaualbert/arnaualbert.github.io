---
interface TimelineItem {
  title: string;
  subtitle?: string;
  period: string;
}

interface Props {
  items: TimelineItem[];
  sectionId: string;
  sectionTitle: string;
}

const { items, sectionId, sectionTitle } = Astro.props;
---

<section id={sectionId}>
  <h2 class="text-[#f8fafc] text-2xl md:text-3xl mb-6 flex items-center gap-3">
    <span class="text-[#7dd3fc] font-mono text-sm">//</span>
    {sectionTitle}
  </h2>
  <div class="space-y-6">
    {items.map((item) => (
      <div class="border-l-2 border-[#7dd3fc]/50 pl-4 py-2 hover:border-[#7dd3fc] transition-colors">
        <h3 class="text-[#f8fafc] font-medium text-lg">{item.title}</h3>
        {item.subtitle && (
          <p class="text-[#94a3b8] text-sm mt-1">{item.subtitle}</p>
        )}
        <p class="text-[#7dd3fc]/80 text-sm font-mono mt-2">{item.period}</p>
      </div>
    ))}
  </div>
</section>
