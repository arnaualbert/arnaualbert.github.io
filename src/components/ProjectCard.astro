---
export interface Project {
  category: string;
  icon: string;
  name: string;
  description: string;
  tags: { label: string; primary?: boolean }[];
  linkIcon: string;
  linkText: string;
  linkHref: string;
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { category, icon, name, description, tags, linkIcon, linkText, linkHref } = project;
---

<div
  class="p-6 rounded-xl bg-surface-container-low shadow-sm flex flex-col justify-between hover:bg-surface-container transition-all group"
>
  <div>
    <div class="flex items-center justify-between mb-4">
      <span class="font-code text-label-sm text-primary uppercase">{category}</span>
      <span
        class="material-symbols-outlined text-outline group-hover:text-primary transition-colors text-[20px]"
      >{icon}</span>
    </div>
    <h3
      class="font-headline-md text-headline-md text-on-surface font-semibold mb-2 group-hover:text-primary transition-colors"
    >{name}</h3>
    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed mb-6">
      {description}
    </p>
  </div>
  <div>
    <div class="flex flex-wrap gap-1.5 mb-5">
      {tags.map((tag) => (
        <span
          class:list={[
            'px-2 py-0.5 rounded bg-surface-container font-code text-label-sm',
            tag.primary ? 'text-primary' : 'text-on-surface-variant',
          ]}
        >{tag.label}</span>
      ))}
    </div>
    <a
      class="inline-flex items-center gap-2 font-code text-code text-on-surface hover:text-primary transition-colors"
      href={linkHref}
      rel="noopener noreferrer"
      target="_blank"
    >
      <span class="material-symbols-outlined text-[16px]">{linkIcon}</span>
      {linkText}
    </a>
  </div>
</div>