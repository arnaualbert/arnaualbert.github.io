---
const navLinks = [
  { label: 'Overview',   href: '#',           active: true },
  { label: 'About',      href: '#about',      active: false },
  { label: 'Experience', href: '#experience', active: false },
  { label: 'Projects',   href: '#projects',   active: false },
  { label: 'Contact',    href: '#contact',    active: false },
];
---

<header
  class="fixed top-0 left-0 w-full z-50 bg-surface/80 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"
>
  <div class="h-16 max-w-7xl mx-auto px-6 lg:px-12 flex items-center justify-between">
    <div class="flex items-center gap-space-md">
      <a class="flex items-center gap-space-sm" data-path="overview" href="#">
        <span
          class="font-headline-sm text-headline-sm text-on-surface font-semibold tracking-tight"
        >Arnau Albert Sánchez</span>
      </a>
      <span
        class="hidden sm:inline-flex items-center px-space-xs py-0.5 rounded-DEFAULT bg-surface-container-high text-on-surface-variant font-code text-code"
      >Full Stack &amp; DevOps</span>
    </div>

    <nav class="hidden md:flex items-center gap-space-lg">
      {navLinks.map(({ label, href, active }) => (
        <a
          href={href}
          aria-current={active ? 'page' : undefined}
          class={
            active
              ? 'transition-colors text-on-surface bg-surface-container-high rounded px-3 py-1.5 font-medium'
              : 'text-on-surface-variant hover:text-on-surface hover:bg-surface-container-low px-3 py-1.5 rounded transition-colors font-label-md text-label-md'
          }
        >{label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-space-md">
      <div
        class="hidden lg:flex items-center gap-space-xs px-space-sm py-1 rounded-full bg-surface-container-low"
      >
        <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
        <span
          class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"
        >Available for roles</span>
      </div>
      <a
        class="px-space-md py-1.5 rounded bg-surface-container-high text-on-surface hover:bg-surface-container-highest transition-colors font-label-md text-label-md font-medium"
        href="#contact"
      >Resume / Contact</a>
      <div
        class="w-8 h-8 rounded-full bg-primary flex items-center justify-center shrink-0"
      >
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </div>
    </div>
  </div>
</header>