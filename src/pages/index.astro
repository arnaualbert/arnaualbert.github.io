  <script>
    function handleTransmission(): void {
      const btn = document.getElementById('submitBtn') as HTMLButtonElement | null;
      const feedback = document.getElementById('formFeedback');
      const form = document.getElementById('contactForm') as HTMLFormElement | null;
      if (!btn || !feedback || !form) return;

      btn.disabled = true;
      btn.innerHTML =
        '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Routing packet...';

      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">done</span> Transmitted';
        btn.classList.remove('bg-primary');
        btn.classList.add('bg-surface-container', 'text-on-surface');
        feedback.textContent = 'Transmission acknowledged. Response within 24 standard hours.';
        form.reset();

        setTimeout(() => {
          btn.disabled = false;
          btn.innerHTML =
            '<span class="material-symbols-outlined text-[18px]">send</span> Dispatch Transmission';
          btn.classList.remove('bg-surface-container', 'text-on-surface');
          btn.classList.add('bg-primary', 'text-on-primary');
        }, 4000);
      }, 900);
    }

    document.getElementById('contactForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      handleTransmission();
    });
  </script>
