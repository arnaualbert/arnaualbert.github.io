                        btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">done</span> Transmitted';
                        btn.classList.remove('bg-primary');
                        btn.classList.add('bg-surface-container', 'text-on-surface');
                        feedback.textContent = 'Transmission acknowledged. Response within 24 standard hours.';
                        form.reset();

                        setTimeout(() => {
                            btn.disabled = false;
                            btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">send</span> Dispatch Transmission';
                            btn.classList.remove('bg-surface-container', 'text-on-surface');
                            btn.classList.add('bg-primary', 'text-on-primary');
                        }, 4000);
                    }, 900);
                }
            </script>
