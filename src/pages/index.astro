---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TimelineSection from '../components/TimelineSection.astro';

const experienceItems = [
  { title: 'Full Stack & DevOps @ Barcelona Supercomputing Center (BSC)', period: 'Jun 2024 - Present' },
  { title: 'Full Stack @ Institut Recerca Biomedica Barcelona (IRB)', period: 'Jun 2023 - Jun 2024' },
  { title: 'Internship @ Barcelona Supercomputing Center (BSC)', period: 'Jan 2023 - Jun 2023' },
  { title: 'IT Technician @ Jesuïtes de Sarrià', period: 'Jan 2019 - Jun 2019' },
];

const studiesItems = [
  { title: 'ASIX (Advanced Systems Administration)', period: 'Sep 2023 - Jun 2024' },
  { title: 'DAW with Bioinformatics Profile', period: 'Sep 2021 - Jun 2023' },
  { title: 'SMX (Microcomputer Systems and Networks)', period: 'Sep 2019 - Jun 2021' },
];

const projects = [
  {
    name: 'Doctor AI',
    description: 'Bioinformatics platform with Golang tools for genetic file analysis and deep learning for lung cancer detection.',
    github: 'https://github.com/arnaualbert/doctor_ai',
  },
  {
    name: 'Samplexer',
    description: 'Internal application deployed at BSC, IRB & AWS for generating bioinformatics commands, tracking jobs, and automatic database management.',
  },
  {
    name: 'Portfolio',
    description: 'Executive portfolio built with Astro, TypeScript, and Tailwind CSS, deployed on GitHub Pages.',
    github: 'https://github.com/arnaualbert/arnaualbert.github.io',
  },
  {
    name: 'TicTac Scheduler',
    description: 'CLI task manager in Golang with SQLite3 for job tracking without external dependencies.',
    github: 'https://github.com/arnaualbert/tictac_scheduler',
  },
  {
    name: 'Cracks',
    description: 'VPC management software that creates and manages KVM virtual machines, Docker containers, and cloud storage solutions.',
    github: 'https://github.com/arnaualbert/cracks',
  },
  {
    name: 'Tasty Venus',
    description: 'Simple website built to practice Astro, TypeScript, and Tailwind CSS with GitHub Pages deployment.',
    github: 'https://github.com/arnaualbert/tasty-venus',
    demo: 'https://arnaualbert.github.io/tasty-venus/',
  },
];

const techStack = {
  languages: ['Golang', 'Python', 'TypeScript', 'JavaScript', 'SQL'],
  frameworks: ['Astro', 'React', 'FastAPI', 'Flask', 'Node.js', 'Laravel'],
  infrastructure: ['Docker', 'KVM', 'AWS', 'DevOps', 'Cloud Services'],
};
---

<BaseLayout title="Arnau Albert Sánchez | Full Stack Developer">
  <Navbar />
  
  <!-- Hero Section -->
  <section id="hero" class="pt-32 pb-16 px-4 min-h-screen flex items-center">
    <div class="max-w-5xl mx-auto w-full">
      <!-- Credibility Strip -->
      <div class="mb-8 p-4 bg-[#161a22]/80 border border-[#334155] rounded-lg">
        <div class="flex flex-wrap gap-4 items-center justify-center md:justify-start">
          <span class="text-[#7dd3fc] font-mono text-sm">01 // ARCHITECTURE & FOCUS</span>
          <div class="hidden md:block w-px h-4 bg-[#334155]"></div>
          <span class="text-[#94a3b8] text-sm">2+ Years Experience</span>
          <div class="hidden md:block w-px h-4 bg-[#334155]"></div>
          <span class="text-[#94a3b8] text-sm">BSC & IRB Barcelona</span>
          <div class="hidden md:block w-px h-4 bg-[#334155]"></div>
          <span class="text-[#94a3b8] text-sm">Golang + Python + Cloud/DevOps</span>
        </div>
      </div>
      
      <h1 class="text-[#f8fafc] text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
        Arnau Albert Sánchez
      </h1>
      <h2 class="text-[#94a3b8] text-xl md:text-2xl mb-8">
        Full Stack Developer & DevOps Engineer @ Barcelona
      </h2>
      
      <!-- Technical Matrix -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-12">
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-4">
          <h3 class="text-[#7dd3fc] font-mono text-xs mb-3">// RUNTIME LANGUAGES</h3>
          <div class="flex flex-wrap gap-2">
            {techStack.languages.map((lang) => (
              <span class="text-[#94a3b8] text-xs px-2 py-1 bg-[#0c0e12] border border-[#334155] rounded">{lang}</span>
            ))}
          </div>
        </div>
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-4">
          <h3 class="text-[#7dd3fc] font-mono text-xs mb-3">// FRAMEWORKS & ENGINES</h3>
          <div class="flex flex-wrap gap-2">
            {techStack.frameworks.map((fw) => (
              <span class="text-[#94a3b8] text-xs px-2 py-1 bg-[#0c0e12] border border-[#334155] rounded">{fw}</span>
            ))}
          </div>
        </div>
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-4">
          <h3 class="text-[#7dd3fc] font-mono text-xs mb-3">// INFRASTRUCTURE</h3>
          <div class="flex flex-wrap gap-2">
            {techStack.infrastructure.map((infra) => (
              <span class="text-[#94a3b8] text-xs px-2 py-1 bg-[#0c0e12] border border-[#334155] rounded">{infra}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- About Section -->
  <section id="about" class="py-16 px-4 bg-[#161a22]/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-[#f8fafc] text-2xl md:text-3xl mb-6 flex items-center gap-3">
        <span class="text-[#7dd3fc] font-mono text-sm">02 //</span>
        CHRONICLE & CREDENTIALS
      </h2>
      <div class="text-[#94a3b8] space-y-4 leading-relaxed">
        <p>Hello! I'm a passionate Full Stack Developer with 2+ years of experience building innovative software solutions at prestigious institutions like Barcelona Supercomputing Center and IRB Barcelona.</p>
        <p>My journey began with a desire to create my own software, leading me to dive deep into coding and problem-solving across multiple domains.</p>
        
        <div class="space-y-3 my-6">
          <div class="pl-4 border-l-2 border-[#7dd3fc]/50">
            <p class="text-[#f8fafc] font-medium">Personal Cloud Service:</p>
            <p class="text-[#94a3b8] text-sm mt-1">Created a cloud platform that automatically spins up Docker containers with preinstalled software like Joomla and WordPress, implemented virtual machines using KVM, and provided cloud storage solutions.</p>
          </div>
          <div class="pl-4 border-l-2 border-[#7dd3fc]/50">
            <p class="text-[#f8fafc] font-medium">Bioinformatics Tools:</p>
            <p class="text-[#94a3b8] text-sm mt-1">Built specialized services offering bioinformatics analysis tools, streamlining the processing of complex scientific data.</p>
          </div>
        </div>
        
        <p>I work with Python, Flask, FastAPI, Node.js, Astro, TypeScript, JavaScript, Laravel, React, SQL, Golang, and Docker. My expertise extends to cloud development (AWS) and DevOps practices, ensuring scalable and efficient solutions.</p>
        <p>When not coding, I enjoy watching football, following MotoGP & F1, and capturing moments through photography.</p>
      </div>
    </div>
  </section>
  
  <!-- Experience & Studies Grid -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      <TimelineSection 
        sectionId="experience" 
        sectionTitle="Work Experience" 
        items={experienceItems} 
      />
      <TimelineSection 
        sectionId="studies" 
        sectionTitle="Formal Education" 
        items={studiesItems} 
      />
    </div>
  </section>
  
  <!-- Projects Section -->
  <section id="projects" class="py-16 px-4 bg-[#161a22]/30">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-[#f8fafc] text-2xl md:text-3xl mb-8 text-center flex items-center justify-center gap-3">
        <span class="text-[#7dd3fc] font-mono text-sm">03 //</span>
        ARTIFACTS & CODEBASES
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Contact Section -->
  <section id="contact" class="py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-[#f8fafc] text-2xl md:text-3xl mb-8 text-center">
        Direct Dispatch Terminal
      </h2>
      <div class="bg-[#161a22]/80 border border-[#334155] rounded-lg p-8">
        <p class="text-[#94a3b8] text-center mb-6">
          Available for collaborations and opportunities
        </p>
        <div class="flex justify-center gap-6">
          <a 
            href="https://github.com/arnaualbert" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="GitHub Profile"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a 
            href="https://x.com/arnaualbert2003" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="X (Twitter) Profile"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a 
            href="mailto:arnaualbert2003@gmail.com" 
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="Email Address"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/>
              <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/>
            </svg>
          </a>
          <a 
            href="https://www.linkedin.com/in/arnau-albert-s%C3%A1nchez-81211826b/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Footer -->
  <footer class="py-8 px-4 border-t border-[#334155]">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-[#94a3b8] text-sm">
        © {new Date().getFullYear()} Arnau Albert Sánchez. Built with Astro & TypeScript.
      </p>
    </div>
  </footer>
</BaseLayout>
