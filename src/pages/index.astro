---
import Layout from '../layouts/Layout.astro';

/* ---------- Experience calculation (build-time) ---------- */
const startDate = new Date('2023-01-16');
const today = new Date();
const timeDiff = today.getTime() - startDate.getTime();
const daysDiff = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
const yearsDiff = Math.floor(daysDiff / 365);
const monthsDiff = Math.floor((daysDiff % 365) / 30);

let experienceText: string;
if (yearsDiff >= 1) {
  if (monthsDiff >= 6) experienceText = `${yearsDiff}+ Years`;
  else if (monthsDiff >= 3) experienceText = `${yearsDiff}.5 Years`;
  else experienceText = `${yearsDiff} Year${yearsDiff > 1 ? 's' : ''}`;
} else {
  experienceText = `${monthsDiff} Months`;
}
