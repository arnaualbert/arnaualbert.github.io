---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TimelineSection from '../components/TimelineSection.astro';
import { getTranslations, calculateYearsExperience } from '../i18n/utils';
import { portfolioData } from '../data/portfolio';

// Get language from URL or default to English
const lang = Astro.url.searchParams.get('lang') || 'en';
const t = getTranslations(lang as keyof typeof import('../i18n/ui').ui);

// Calculate years of experience dynamically
const yearsExp = calculateYearsExperience(portfolioData.startYear);

const experienceItems = portfolioData.workExperience.map(exp => ({
  title: `${exp.role} @ ${exp.institution}`,
  period: exp.period,
}));

const studiesItems = portfolioData.education.map(edu => ({
  title: edu.degree,
  period: edu.period,
}));
---

<BaseLayout title={`${portfolioData.name} | ${t('hero.title')}`} lang={lang}>
  <Navbar lang={lang} />
  
  <!-- Hero Section -->
  <section id="hero" class="pt-32 pb-16 px-4 min-h-screen flex items-center">
    <div class="max-w-5xl mx-auto w-full">
      <!-- Credibility Strip -->
      <div class="mb-8 p-4 bg-[#161a22]/80 border border-[#334155] rounded-lg">
        <div class="flex flex-wrap gap-4 items-center justify-center md:justify-start">
          <span class="text-[#7dd3fc] font-mono text-sm">{t('section.architecture')}</span>
          <div class="hidden md:block w-px h-4 bg-[#334155]"></div>
          <span class="text-[#94a3b8] text-sm">{yearsExp}+ {t('credibility.experience')}</span>
          <div class="hidden md:block w-px h-4 bg-[#334155]"></div>
          <span class="text-[#94a3b8] text-sm">{portfolioData.affiliations.join(' & ')}</span>
          <div class="hidden md:block w-px h-4 bg-[#334155]"></div>
          <span class="text-[#94a3b8] text-sm">{portfolioData.coreStack.join(' + ')}</span>
        </div>
      </div>
      
      <h1 class="text-[#f8fafc] text-4xl md:text-5xl lg:text-6xl font-bold mb-4">
        {portfolioData.name}
      </h1>
      <h2 class="text-[#94a3b8] text-xl md:text-2xl mb-8">
        {t('hero.title')}
      </h2>
      <p class="text-[#94a3b8] text-lg mb-8 max-w-3xl">
        {t('hero.subtitle')}
      </p>
      
      <!-- Technical Matrix -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-12">
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-4">
          <h3 class="text-[#7dd3fc] font-mono text-xs mb-3">// {t('matrix.runtime').toUpperCase()}</h3>
          <div class="flex flex-wrap gap-2">
            {portfolioData.technicalMatrix.runtime.map((lang) => (
              <span class="text-[#94a3b8] text-xs px-2 py-1 bg-[#0c0e12] border border-[#334155] rounded">{lang}</span>
            ))}
          </div>
        </div>
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-4">
          <h3 class="text-[#7dd3fc] font-mono text-xs mb-3">// {t('matrix.frameworks').toUpperCase()}</h3>
          <div class="flex flex-wrap gap-2">
            {portfolioData.technicalMatrix.frameworks.map((fw) => (
              <span class="text-[#94a3b8] text-xs px-2 py-1 bg-[#0c0e12] border border-[#334155] rounded">{fw}</span>
            ))}
          </div>
        </div>
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-4">
          <h3 class="text-[#7dd3fc] font-mono text-xs mb-3">// {t('matrix.infra').toUpperCase()}</h3>
          <div class="flex flex-wrap gap-2">
            {portfolioData.technicalMatrix.infrastructure.map((infra) => (
              <span class="text-[#94a3b8] text-xs px-2 py-1 bg-[#0c0e12] border border-[#334155] rounded">{infra}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- About Section -->
  <section id="about" class="py-16 px-4 bg-[#161a22]/30">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-[#f8fafc] text-2xl md:text-3xl mb-6 flex items-center gap-3">
        <span class="text-[#7dd3fc] font-mono text-sm">02 //</span>
        {t('section.chronicle').replace('02 // ', '')}
      </h2>
      
      <!-- Philosophy Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-6">
          <h3 class="text-[#7dd3fc] font-mono text-sm mb-3">{t('about.philosophy')}</h3>
          <p class="text-[#94a3b8] leading-relaxed">{t('about.philosophy.text')}</p>
        </div>
        <div class="bg-[#161a22]/50 border border-[#334155] rounded-lg p-6">
          <h3 class="text-[#7dd3fc] font-mono text-sm mb-3">{t('about.learning')}</h3>
          <p class="text-[#94a3b8] leading-relaxed">{t('about.learning.text')}</p>
        </div>
      </div>
      
      <div class="text-[#94a3b8] space-y-4 leading-relaxed">
        <p>{t('hero.subtitle')}</p>
      </div>
    </div>
  </section>
  
  <!-- Experience & Studies Grid -->
  <section class="py-16 px-4">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8">
      <TimelineSection 
        sectionId="experience" 
        sectionTitle={t('timeline.work')} 
        items={experienceItems} 
      />
      <TimelineSection 
        sectionId="studies" 
        sectionTitle={t('timeline.education')} 
        items={studiesItems} 
      />
    </div>
  </section>
  
  <!-- Projects Section -->
  <section id="projects" class="py-16 px-4 bg-[#161a22]/30">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-[#f8fafc] text-2xl md:text-3xl mb-8 text-center flex items-center justify-center gap-3">
        <span class="text-[#7dd3fc] font-mono text-sm">03 //</span>
        {t('section.artifacts').replace('03 // ', '')}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {portfolioData.projects.map((project) => (
          <ProjectCard project={project} t={t} />
        ))}
      </div>
    </div>
  </section>
  
  <!-- Contact Section -->
  <section id="contact" class="py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-[#f8fafc] text-2xl md:text-3xl mb-8 text-center">
        {t('dispatch.title')}
      </h2>
      <div class="bg-[#161a22]/80 border border-[#334155] rounded-lg p-8">
        <p class="text-[#94a3b8] text-center mb-6">
          {t('dispatch.subtitle')}
        </p>
        <div class="flex justify-center gap-6">
          <a 
            href={portfolioData.contact.github} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="GitHub Profile"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a 
            href={portfolioData.contact.linkedin} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>
            </svg>
          </a>
          <a 
            href={portfolioData.contact.twitter} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="X (Twitter) Profile"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a 
            href={`mailto:${portfolioData.contact.email}`} 
            class="text-[#94a3b8] hover:text-[#7dd3fc] transition-colors"
            aria-label="Email Address"
          >
            <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
              <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/>
              <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Footer -->
  <footer class="py-8 px-4 border-t border-[#334155]">
    <div class="max-w-6xl mx-auto text-center">
      <p class="text-[#94a3b8] text-sm mb-2">
        © {new Date().getFullYear()} {portfolioData.name}. {t('footer.credit')}
      </p>
      <!-- Language Switcher -->
      <div class="flex justify-center gap-4 mt-4">
        <a href="?lang=en" class="text-[#7dd3fc] hover:text-[#f8fafc] transition-colors text-sm">English</a>
        <span class="text-[#334155]">|</span>
        <a href="?lang=es" class="text-[#7dd3fc] hover:text-[#f8fafc] transition-colors text-sm">Español</a>
        <span class="text-[#334155]">|</span>
        <a href="?lang=ca" class="text-[#7dd3fc] hover:text-[#f8fafc] transition-colors text-sm">Català</a>
      </div>
    </div>
  </footer>
</BaseLayout>
